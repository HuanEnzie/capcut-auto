# Chép file này thành .env rồi điền key. App tự nạp khi khởi động (assetlib.load_env).
# .env KHÔNG được đưa lên git / gửi cho người khác — key nằm nguyên văn trong đó.
GEMINI_API_KEY=
PEXELS_API_KEY=

# Tuỳ chọn: nhiều key để xoay khi cạn hạn ngạch.
# CHỈ có tác dụng nếu các key thuộc PROJECT KHÁC NHAU — Google tính hạn ngạch theo
# project, mọi key trong cùng project dùng chung một túi quota.
# GEMINI_API_KEYS=key_project_1,key_project_2
